# Local development only. Compose reads .env; locally running Spring does not.
DATABASE_URL=jdbc:postgresql://localhost:5432/coupleoutfit
DATABASE_USERNAME=coupleoutfit_local
DATABASE_PASSWORD=local_dev_only
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Purchase links: required in staging/production; optional stable key for local restarts.
# Supply Base64 encoding of at least 32 random bytes through secret configuration.
# PURCHASE_TOKEN_KEY=
